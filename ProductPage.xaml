<Page x:Class="Laba10.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Laba10"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      FontFamily="Comic Sans MS"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Name="OrderBtn" Content="Просмотр заказа" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="220" Visibility="Collapsed" Click="OrderBtn_Click"/>

        <StackPanel Grid.Row="0" Margin="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Вы авторизованы как " FontSize="20"/>
                <TextBlock Name="FIOTB" FontSize="20"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Роль: " FontSize="20"/>
                <TextBlock Name="RoleTB" FontSize="20"/>
            </StackPanel>
        </StackPanel>
        
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            
            <TextBlock Name="TBCount" Text="кол-во 0 из 0" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,10,0"/>

            
            <StackPanel Margin="5,0">
                <TextBlock Text="поиск по наименованию" FontSize="16"/>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="200" FontSize="15"/>
            </StackPanel>

            
            <StackPanel Margin="10,0" VerticalAlignment="Bottom">
                <RadioButton Content="по возрастанию стоимости" GroupName="Sort" FontSize="16"
                         Name="RButtonUp" Checked="RButtonUp_Checked"/>
                <RadioButton Content="по убыванию стоимости" GroupName="Sort" FontSize="16"
                         Name="RbuttonDown" Checked="RbuttonDown_Checked"/>
            </StackPanel>

            
            <StackPanel Margin="10,0">
                <TextBlock Text="фильтрация по скидке" FontSize="16"/>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="15" Width="200">
                    <TextBlock>Все диапазоны</TextBlock>
                    <TextBlock>0-9,99%</TextBlock>
                    <TextBlock>10-14,99%</TextBlock>
                    <TextBlock>15% и более</TextBlock>
                </ComboBox>
            </StackPanel>
        </StackPanel>
     
        <ListView Name="ProductListView" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="700"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Image Width="175" Grid.Column="0" Grid.RowSpan="4" Stretch="Uniform" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="PhotoProduct">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            Image/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="16" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding Manufacturer.ManufacturerName}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="16"></TextBlock>
                        <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" FontSize="16"></TextBlock>

                        <TextBlock Text="Скидка" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" FontSize="16" Margin="0,5,10,5" ></TextBlock>
                        <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Margin="0,0,10,0" HorizontalAlignment="Right" FontSize="30"></TextBlock>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
