<Page x:Class="Laba10.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Laba10"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Губайдуллин41" Height="450" Width="800"
      FontFamily="Comic Sans MS"
      >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин" Grid.Row="1" Grid.Column="0" FontSize="30" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="285,0,0,0"/>
        <TextBox Name="LoginTB" Grid.Row="1" Grid.Column="1" Width="250" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="30" Margin="28,0,0,0" />

        <TextBlock Text="Пороль" Grid.Row="2" Grid.Column="0" FontSize="30" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="271,0,0,0" Width="117"/>
        <TextBox Name="PassTB" Grid.Row="2" Grid.Column="1" Width="250" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="30" Margin="28,0,0,0" />

        <Button Name="GuesBtn" Content="Войти как гость" Grid.Row="3" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Click="GuesBtn_Click" Height="40" Width="230"/>
        <Button Name="LoginBtn" Grid.Row="3" Grid.Column="1" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Войти" Height="40" Width="200" Click="LoginBtn_Click"/>

        <StackPanel Name="CaptchaPanel" Grid.Row="4" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
                <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"></TextBlock>
                <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
                <TextBlock Name="captchaFourWord" FontSize="22" Margin="0,5,0,0"></TextBlock>
            </StackPanel>
            <TextBox Name="CaptchaTB" Width="250" FontSize="20" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel>

    </Grid>
</Page>
